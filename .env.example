# Copy to .env.local and fill in. Never commit real values.

# --- public (safe in client components) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# --- server only ---
# WordPress origin. Defaults to https://majeurs.com; https://cms.majeurs.com once WP moves behind the headless front.
WP_URL=https://majeurs.com
# = MAJEURS_HEADLESS_SECRET in wp-config.php (docs/wordpress/majeurs-account.php). Account, wishlist and enquiry forms.
WP_ACCOUNT_SECRET=
# WordPress user (Author role) + Application Password for form file uploads to the media library (lib/api/media.ts)
WP_UPLOAD_USER=
WP_UPLOAD_APP_PASSWORD=
# Shared with WordPress (Settings > General > "Majeurs revalidate secret", docs/wordpress/majeurs-content.php):
# saving content in wp-admin calls /api/revalidate with it. Any long random string.
REVALIDATE_SECRET=
# Parallel requests to WP per server process (lib/api/wp.ts). Lower it if WP answers 5xx during builds.
# WP_MAX_CONCURRENCY=6

# reCAPTCHA v3 on every public form (google.com/recaptcha/admin). Leave both empty to switch it off locally.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# 0–1: lower lets more through. 0.7 = the old WordPress setting.
RECAPTCHA_MIN_SCORE=0.7
# reCAPTCHA v2 checkbox, shown when the v3 score is too low. Leave empty to reject low scores instead.
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=

# --- planned, not read by the code yet ---
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=    # Stripe Payment Element at checkout

# Sent as X-Majeurs-Origin on server calls to WP; the Cloudflare WAF skips its custom rules for it
WP_ORIGIN_TOKEN=

# --- local scripts only (never on Vercel) ---
# An admin's Application Password (wp-admin > Users > Profile > Application Passwords; not the login password),
# for `npm run content:seed` / `content:status` (scripts/content.mts)
WP_ADMIN_USER=
WP_ADMIN_APP_PASSWORD=
