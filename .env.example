# Copy to .env.local and fill in. Never commit real values.

# --- public (safe in client components) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- server only ---
# WordPress origin. Defaults to https://majeurs.com; https://cms.majeurs.com once WP moves behind the headless front.
WP_URL=https://majeurs.com
# = MAJEURS_HEADLESS_SECRET in wp-config.php (docs/wordpress/majeurs-account.php). Account, wishlist and enquiry forms.
WP_ACCOUNT_SECRET=

# --- planned, not read by the code yet ---
# REVALIDATE_SECRET=                     # shared with the WP revalidation hook (app/api/revalidate)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=    # Stripe Payment Element at checkout
